<section class="max-w-5xl mx-auto py-12 bg-gray-50 p-6 rounded-xl shadow-2xl mt-10 mb-10">
    <h2 class="text-3xl font-extrabold text-gray-900 mb-8 border-b-2 pb-2">
        Book Your Service
    </h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
        <div class="p-6 bg-white border border-gray-200 rounded-lg shadow-lg space-y-5">
            <h3 class="text-xl font-bold text-indigo-700 border-b pb-3 mb-4">
                Service Provider Details
            </h3>

            <div class="space-y-3">
                <p class="text-lg font-semibold text-gray-800">
                    Service: <span class="font-normal text-gray-600"> <%= @provider_service.services.name %> </span>
                </p>
                <p class="text-lg font-semibold text-gray-800">
                    Description: <span class="font-normal text-gray-600"> <%= @provider_service.services.description %> </span>
                </p>
                <p class="text-lg font-semibold text-gray-800">
                    Category: <span class="font-normal text-gray-600">  <%= @provider_service.services.category.name %> </span>
                </p>
            </div>

            <div class="pt-4 border-t mt-4 space-y-3">
                <p class="text-lg font-semibold text-gray-800">
                    Provider: <span class="font-normal text-gray-600">  <%= @provider_service.service_providers.users.username %></span>
                </p>
                <p class="text-lg font-semibold text-gray-800">
                    Bio: <span class="font-normal text-gray-600"> <%= @provider_service.service_providers.bio %></span>
                </p>
                <p class="text-xl font-bold text-green-600">
                    Rate: Nu.<%= @provider_service.custom_price %> /-
                </p>
            </div>
        </div>


        <form class="p-6 bg-white border border-gray-200 rounded-lg shadow-lg space-y-6">
         
            <h3 class="text-xl font-bold text-indigo-700 border-b pb-3 mb-4">
                Complete Booking Details
            </h3>
            <p class="text-sm text-gray-500">
                Fill in your details below to proceed to the payment step.
            </p>

            <div class="flex flex-col space-y-1">
                <label for="address" class="flex items-center text-sm font-medium text-gray-700">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pin-map mr-2 text-indigo-500" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M3.1 11.2a.5.5 0 0 1 .4-.2H6a.5.5 0 0 1 0 1H3.75L1.5 15h13l-2.25-3H10a.5.5 0 0 1 0-1h2.5a.5.5 0 0 1 .4.2l3 4a.5.5 0 0 1-.4.8H.5a.5.5 0 0 1-.4-.8z"/>
                        <path fill-rule="evenodd" d="M8 1a3 3 0 1 0 0 6 3 3 0 0 0 0-6M4 4a4 4 0 1 1 4.5 3.969V13.5a.5.5 0 0 1-1 0V7.97A4 4 0 0 1 4 3.999z"/>
                    </svg>
                    Service Address
                </label>
                <input type="text" id="address" name="address" placeholder="Enter service location" class="p-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500 w-full transition duration-150 ease-in-out" required />
            </div>

            <div class="flex flex-col space-y-1">
                <label for="day" class="flex items-center text-sm font-medium text-gray-700">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar2-week mr-2 text-indigo-500" viewBox="0 0 16 16">
                        <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M2 2a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z"/>
                        <path d="M2.5 4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5H3a.5.5 0 0 1-.5-.5zM11 7.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm-3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm-5 3a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5z"/>
                    </svg>
                    Preferred Day
                </label>
                <select id="day" name="day" class="p-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500 w-full transition duration-150 ease-in-out" required>
                    <option value="" disabled selected>Select a weekday</option>  
                    <option value="monday">Monday</option>
                    <option value="tuesday">Tuesday</option>
                    <option value="wednesday">Wednesday</option>
                    <option value="thursday">Thursday</option>
                    <option value="friday">Friday</option>
                    <option value="saturday">Saturday</option>
                    <option value="sunday">Sunday</option>
                </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="flex flex-col space-y-1">
                    <label for="contact" class="flex items-center text-sm font-medium text-gray-700">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-telephone-plus mr-2 text-indigo-500" viewBox="0 0 16 16">
                            <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"/>
                            <path fill-rule="evenodd" d="M12.5 1a.5.5 0 0 1 .5.5V3h1.5a.5.5 0 0 1 0 1H13v1.5a.5.5 0 0 1-1 0V4h-1.5a.5.5 0 0 1 0-1H12V1.5a.5.5 0 0 1 .5-.5"/>
                        </svg>
                        Contact Number
                    </label>
                    <input type="number" id="contact" name="contact" placeholder="e.g., 17xxxxxx" class="p-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500 w-full transition duration-150 ease-in-out" required />
                </div>

                <div class="flex flex-col space-y-1">
                    <label for="email" class="flex items-center text-sm font-medium text-gray-700">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-envelope-at mr-2 text-indigo-500" viewBox="0 0 16 16">
                            <path d="M2 2a2 2 0 0 0-2 2v8.01A2 2 0 0 0 2 14h5.5a.5.5 0 0 0 0-1H2a1 1 0 0 1-.966-.741l5.64-3.471L8 9.583l7-4.2V8.5a.5.5 0 0 0 1 0V4a2 2 0 0 0-2-2zm3.708 6.208L1 11.105V5.383zM1 4.217V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v.217l-7 4.2z"/>
                            <path d="M14.247 14.269c1.01 0 1.587-.857 1.587-2.025v-.21C15.834 10.43 14.64 9 12.52 9h-.035C10.42 9 9 10.36 9 12.432v.214C9 14.82 10.438 16 12.358 16h.044c.594 0 1.018-.074 1.237-.175v-.73c-.245.11-.673.18-1.18.18h-.044c-1.334 0-2.571-.788-2.571-2.655v-.157c0-1.657 1.058-2.724 2.64-2.724h.04c1.535 0 2.484 1.05 2.484 2.326v.118c0 .975-.324 1.39-.639 1.39-.232 0-.41-.148-.41-.42v-2.19h-.906v.569h-.03c-.084-.298-.368-.63-.954-.63-.778 0-1.259.555-1.259 1.4v.528c0 .892.49 1.434 1.26 1.434.471 0 .896-.227 1.014-.643h.043c.118.42.617.648 1.12.648m-2.453-1.588v-.227c0-.546.227-.791.573-.791.297 0 .572.192.572.708v.367c0 .573-.253.744-.564.744-.354 0-.581-.215-.581-.8Z"/>
                        </svg>
                        Email Address
                    </label>
                    <input type="email" id="email" name="email" placeholder="you@example.com" class="p-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500 w-full transition duration-150 ease-in-out" required />
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-between pt-4 border-t-2 border-dashed mt-6">
                <div class="flex items-baseline space-x-2 mb-4 sm:mb-0">
                  <p class="text-lg font-medium text-gray-700">Total Amount: Nu. <%= @provider_service.custom_price %>  /- </p>
                   
                </div>

                <button type="submit" class="w-full sm:w-auto flex items-center justify-center space-x-2 bg-[#121e30] text-white px-6 py-2 rounded-lg font-semibold text-lg transition-all duration-300 shadow-xl  hover:shadow-2xl transform hover:scale-105">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-credit-card" viewBox="0 0 16 16">
                      <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v1h14V4a1 1 0 0 0-1-1zm13 4H1v5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1z"/>
                      <path d="M2 10a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/>
                    </svg>
                    <span>Pay</span>
                </button>
            </div>
        
        </form>
    </div>
</section>
