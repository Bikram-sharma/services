<Layouts.flash_group flash={@flash} />
<section>
    <div class="h-[55vh] bg-[#121e30] flex flex-col justify-center">
        <div class="max-w-4xl mx-auto text-center space-y-10 relative">
            <h2 class="text-4xl text-white font-bold relative after:absolute after:left-0 after:right-0 after:-bottom-5 after:h-0.5 after:w-full after:bg-gray-500">Contact Us</h2>
            <p class="text-xl font-normal text-white">Welcome to ServiceHub, the all-in-one digital platform where people can discover, compare, and book services Have questions about our services, bookings, or becoming a service provider? Our team is here to help. Feel free to reach out — we usually respond within 24 hours</p>
        </div>
    </div>
    
    <div class="max-w-[70%] mx-auto bg-white rounded-lg shadow-md  grid sm:grid-cols-1 md:grid-cols-2 gap-10 my-20 md:p-10">
        
        <div class="bg-[#121e30] rounded-lg space-y-15 p-5">
            
            <div class="relative after:absolute after:left-0 after:right-0 after:-bottom-2 after:h-0.5 after:w-full after:bg-gray-500">
                <h2 class="text-2xl text-white font-bold">Contact Information</h2>
                <p class="text-lg font-normal text-white">Any questions or remarks? Just write us a message!</p>
            </div>

            <div class="max-w-[80%] mx-auto space-y-10">
                <div class="flex space-x-6">
                    <.icon name="hero-map-pin" class="size-8 text-white"/>
                    <div class="relative after:absolute after:left-0 after:right-0 after:bottom-0 after:h-full after:w-0.5 after:bg-gray-500">
                        <p class="text-md text-white ml-3">Somewhere Headquarters</p>
                        <p class="text-md text-white ml-3">123 Waka Waka Aie Aie</p>
                    </div>
                </div>
                
                <div class="flex space-x-6">
                    <.icon name="hero-phone" class="size-8 text-white"/>
                    <div class="relative after:absolute after:left-0 after:right-0 after:bottom-0 after:h-full after:w-0.5 after:bg-gray-500">
                        <p class="text-md text-white ml-3">+957 12345678</p>
                        <p class="text-md text-white ml-3">+957 12345678</p>
                    </div>
                </div>
    
                <div class="flex space-x-6">
                    <.icon name="hero-envelope" class="size-8 text-white"/>
                    <div class="relative after:absolute after:left-0 after:right-0 after:bottom-0 after:h-full after:w-0.5 after:bg-gray-500">
                        <p class="text-md text-white ml-3">info@servicehub.com</p>
                        <p class="text-md text-white ml-3">service@servicehub.com</p>
                        <p class="text-md text-white ml-3">support@servicehub.com</p>
                    </div>
                </div>
    
                <div class="flex space-x-6">
                    <.icon name="hero-clock" class="size-8 text-white"/>
                    <div class="relative after:absolute after:left-0 after:right-0 after:bottom-0 after:h-full after:w-0.5 after:bg-gray-500">
                        <p class="text-md text-white ml-3">Monday - Friday</p>
                        <p class="text-md text-white ml-3">8:00 AM - 6:00 PM EST</p>
                        <p class="text-md text-white ml-3">Weekend: By Appointment</p>
                    </div>
                </div>
            </div>
        </div>

        <form class="md:p-5 space-y-6">
            <div class="grid md:grid-cols-2 gap-6">
                <div>
                    <label class="text-[#121e30] mb-2">Full Name *</label>
                    <input type="text" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none" placeholder="Con Doe">
                </div>
                <div>
                    <label for="email" class="text-[#121e30] mb-2">Email Address *</label>
                    <input type="email" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none" placeholder="condoe@chak.com">
                </div>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
                <div>
                    <label for="phone" class="text-[#121e30] mb-2">Phone Number</label>
                    <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none" placeholder="+975 00 000 000">
                </div>
                <div>
                    <label for="company" class="text-[#121e30] mb-2">Company Name</label>
                    <input type="text" id="company" name="company" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none" placeholder="Your Company">
                </div>
            </div>

            <div>
                <label for="subject" class="text-[#121e30] mb-2">Subject *</label>
                <select id="subject" name="subject" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none">
                    <option>Select a subject...</option><option value="general">General Inquiry</option>
                    <option value="spare-parts">For booking issues</option>
                    <option value="quote">For payment problems</option>
                    <option value="supply-management">For becoming a service provider</option>
                    <option value="support">Technical Support</option>
                </select>
            </div>

            <div>
                <label for="message" class="text-[#121e30] mb-2">Message *</label>
                <textarea required rows="6" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none resize-none" placeholder="Tell us about your needs..."></textarea>
            </div>

            <button type="submit" class="w-full bg-[#121e30] text-white px-8 py-4 rounded-xl hover:shadow-xl transition-all duration-300 flex items-center justify-center gap-2">
                <.icon name="hero-paper-airplane" class="size-7 ml-4"/>
                Send Message
            </button>
        </form>
    </div>
</section>