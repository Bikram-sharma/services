<Layouts.flash_group flash={@flash} />
<section>
    <div class="h-[65vh] bg-[#121e30] flex flex-col justify-center">
        <div class="max-w-4xl mx-auto text-center space-y-10 relative">
            <p class="text-4xl text-white font-bold relative after:absolute after:left-0 after:right-0 after:-bottom-5 after:h-0.5 after:w-full after:bg-gray-500">Contact Us</p>
            <p class="text-xl font-normal text-white">Welcome to ServiceHub, the all-in-one digital platform where people can discover, compare, and book services Have questions about our services, bookings, or becoming a service provider? Our team is here to help. Feel free to reach out — we usually respond within 24 hours</p>
        </div>
        <div class="w-full absolute bottom-[25%] grid grid-cols-4 gap-5 px-[10%]">
            <div class="bg-white rounded-2xl shadow-lg p-4 border border-gray-300 hover:shadow-xl">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-blue-200 rounded-xl flex items-center justify-center">
                        <.icon name="hero-map-pin" class="size-7"/>
                    </div>
                    <div class="flex-1">
                        <h4 class="text-xl font-semibold mb-3">Visit Us</h4>
                        <div class="space-y-1">
                            <p class="text-lg text-gray-600">Somewhere Headquarters</p>
                            <p class="text-lg text-gray-600">123 Waka Waka Aie Aie</p>
                            <p class="text-lg text-gray-600">Jama laune Street 500</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="bg-white rounded-2xl shadow-lg p-4 border border-gray-300 hover:shadow-xl">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-blue-200 rounded-xl flex items-center justify-center">
                        <.icon name="hero-phone" class="size-7"/>
                    </div>
                    <div class="flex-1">
                        <h4 class="text-xl font-semibold mb-3">Call Us</h4>
                        <div class="space-y-1">
                            <p class="text-lg text-gray-600">+957 12345678</p>
                            <p class="text-lg text-gray-600">+957 12345678</p>
                            <p class="text-lg text-gray-600">+957 12345678</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-lg p-4 border border-gray-300 hover:shadow-xl">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-blue-200 rounded-xl flex items-center justify-center">
                        <.icon name="hero-envelope" class="size-7"/>
                    </div>
                    <div class="flex-1">
                        <h4 class="text-xl font-semibold mb-3">Email Us</h4>
                        <div class="space-y-1">
                            <p class="text-lg text-gray-600">info@servicehub.com</p>
                            <p class="text-lg text-gray-600">service@servicehub.com</p>
                            <p class="text-lg text-gray-600">support@servicehub.com</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-lg p-4 border border-gray-300 hover:shadow-xl">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-blue-200 rounded-xl flex items-center justify-center">
                        <.icon name="hero-clock" class="size-7"/>
                    </div>
                    <div class="flex-1">
                        <h4 class="text-xl font-semibold mb-3">Business Hours</h4>
                        <div class="space-y-1">
                            <p class="text-lg text-gray-600">Monday - Friday</p>
                            <p class="text-lg text-gray-600">8:00 AM - 6:00 PM EST</p>
                            <p class="text-lg text-gray-600">Weekend: By Appointment</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="max-w-5xl mx-auto px-[10%] py-50">
        
        <form class="bg-white border-2 border-gray-300 rounded-2xl shadow-lg p-5 space-y-6">
            <div class="grid md:grid-cols-2 gap-6">
                <div>
                    <label class="text-[#121e30] mb-2">Full Name *</label>
                    <input type="text" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none" placeholder="John Doe">
                </div>
                <div>
                    <label for="email" class="text-[#121e30] mb-2">Email Address *</label>
                    <input type="email" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none" placeholder="john@company.com">
                </div>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
                <div>
                    <label for="phone" class="text-[#121e30] mb-2">Phone Number</label>
                    <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none" placeholder="+1 (555) 000-0000">
                </div>
                <div>
                    <label for="company" class="text-[#121e30] mb-2">Company Name</label>
                    <input type="text" id="company" name="company" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none" placeholder="Your Company">
                </div>
            </div>

            <div>
                <label for="subject" class="text-[#121e30] mb-2">Subject *</label>
                <select id="subject" name="subject" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none">
                    <option>Select a subject...</option><option value="general">General Inquiry</option>
                    <option value="spare-parts">For booking issues</option>
                    <option value="quote">For payment problems</option>
                    <option value="supply-management">For becoming a service provider</option>
                    <option value="support">Technical Support</option>
                </select>
            </div>

            <div>
                <label for="message" class="text-[#121e30] mb-2">Message *</label>
                <textarea required rows="6" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none resize-none" placeholder="Tell us about your needs..."></textarea>
            </div>

            <button type="submit" class="w-full bg-[#121e30] text-white px-8 py-4 rounded-xl hover:shadow-xl transition-all duration-300 flex items-center justify-center gap-2">
                <.icon name="hero-paper-airplane" class="size-7 ml-4"/>
                Send Message
            </button>
        </form>
    </div>
</section>