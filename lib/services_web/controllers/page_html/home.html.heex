          <h2 class="text-xl font-bold text-gray-900 dark:text-white">Our Vision</h2>
        </div>

        <p class="text-md text-gray-700 dark:text-gray-300 mb-2">
          To become the most trusted and convenient service marketplace, helping individuals and professionals connect, collaborate, and thrive in the digital world.
        </p>
      </div>

      <div class="box border border-gray-300 dark:border-gray-700 shadow rounded-md p-5 scale-105 duration-900 bg-[#f8f8f8] dark:bg-gray-800">
        <div class="flex items-center space-x-2 pb-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            height="50px"
            viewBox="0 -960 960 960"
            width="50px"
            fill="#999999"
            class="dark:fill-gray-400"
          >
            <path d="m384-336 56-58-86-86 86-86-56-58-144 144 144 144Zm192 0 144-144-144-144-56 58 86 86-86 86 56 58ZM200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h168q13-36 43.5-58t68.5-22q38 0 68.5 22t43.5 58h168q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm0-80h560v-560H200v560Zm280-590q13 0 21.5-8.5T510-820q0-13-8.5-21.5T480-850q-13 0-21.5 8.5T450-820q0 13 8.5 21.5T480-790ZM200-200v-560 560Z" />
