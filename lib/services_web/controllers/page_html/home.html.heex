<Layouts.flash_group flash={@flash} />
<!-- ----------Hero Section Start---------- -->
<section class="relative h-[101vh] bg-gradient-to-br from-indigo-800  via-black to-indigo-800 text-white overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div
      class="absolute inset-0"
      style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
    >
    </div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 lg:py-32">
    <div class="text-center max-w-4xl mx-auto place-items-center">
      <div class="w-[20%] h-5 absolute right-[40%] top-[12%]  border-b-4 align-center rounded mb-4 shadow-[0_35px_35px_rgba(255,255,255,1)]">
      </div>
      <div
        class="inline-flex items-center bg-white/20 rounded-full px-4 py-2 mb-8 border"
        style="backdrop-filter: blur(8px);"
      >
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span class="text-sm font-medium">Trusted by 10,000+ users</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
        Connect with trusted service providers in your neighborhood
      </h1>

      <p class="text-lg sm:text-xl lg:text-2xl text-blue-100 mb-10 max-w-3xl mx-auto leading-relaxed">
        Whether you need a service or offer one, we make it simple. Book local professionals instantly or grow your business by joining our community of service providers.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-12">
        <button class="w-full sm:w-auto bg-white hover:text-white hover:border text-black px-4 py-2 rounded-full font-semibold text-lg transition-all duration-200 shadow-xl hover:shadow-2xl transform hover:-translate-y-0.5 hover:bg-gradient-to-br from-indigo-800  via-black to-indigo-800  hover:cursor-pointer">
          <a href="/dash">Find a Service</a>
        </button>
        <button class="w-full sm:w-auto bg-transparent border border-white text-white px-4 py-2 rounded-full font-semibold text-lg transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 hover:bg-gradient-to-br from-indigo-800  via-black to-indigo-800 hover:cursor-pointer">
          <a href="/service_providers/new"> Become a Provider</a>
        </button>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm sm:text-base max-w-3xl mx-auto">
        <div class="flex items-center justify-center space-x-2">
          <svg class="w-5 h-5 text-green-300" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-blue-100">Transparent Pricing</span>
        </div>
        <div class="flex items-center justify-center space-x-2">
          <svg class="w-5 h-5 text-green-300" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-blue-100">Verified Providers</span>
        </div>
        <div class="flex items-center justify-center space-x-2">
          <svg class="w-5 h-5 text-green-300" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-blue-100">Instant Booking</span>
        </div>
        <div class="flex items-center justify-center space-x-2">
          <svg class="w-5 h-5 text-green-300" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-blue-100">Flexible Scheduling</span>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M0 120L60 105C120 90 240 60 360 45C480 30 600 30 720 37.5C840 45 960 60 1080 67.5C1200 75 1320 75 1380 75L1440 75V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z"
        class="fill-[var(--color-base-100)] dark:fill-[var(--color-base-100)]"
      />
    </svg>
  </div>
</section>
<!-- ----------Hero Section End---------- -->

<!-- ----------Categories Section Start---------- -->
 <section class="px-[10%] space-y-10 py-20">
  <div class="border-b border-gray-500 pb-1">
    <h2 class="w-fit text-2xl font-bold space-y-20 relative after:absolute after:left-0 after:right-0 after:-bottom-1 after:h-1 after:w-full after:bg-gray-500">Avail Service from top Categories</h2>
  </div>
  <div class="border border-gray-200">
    <div class="grid grid-cols-4">
      <%= for category <- @categories do %>
      <div class="border border-gray-200 p-4">
        <div class="h-full bg-gradient-to-r from-[#121e30] to-[#1a2f4a] rounded text-white p-8">

          <h3 class="text-lg font-semibold leading-tight mb-1">
            {category.name}
          </h3>
  
          <p class="text-gray-200 text-xs">
            {category.description}
          </p>
        </div>
      </div>
    <% end %>
    </div>
  </div>
 </section>
<!-- ----------Categories Section Start---------- -->

<!-- ----------Services Section Start---------- -->
 <section class="px-[10%] space-y-10 py-20">
   <div class="border-b border-gray-500 pb-1">
    <h2 class="w-fit text-2xl font-bold space-y-20 relative after:absolute after:left-0 after:right-0 after:-bottom-1 after:h-1 after:w-full after:bg-gray-500">Most Availed Services</h2>
   </div>
   <div class="grid grid-cols-4 gap-6">
    <%= for services <- @providers_service do %>
        <div class="bg-white border border-gray-300 rounded p-4">
          <div class="border border-gray-200 rounded-lg shadow-sm hover:shadow-lg transition-all duration-200 overflow-hidden">
            <div class="bg-gradient-to-r from-[#121e30] to-[#1a2f4a] p-8 text-white">
              <h3 class="text-lg font-semibold leading-tight mb-1">
                {services.services.name}
              </h3>
              <p class="text-gray-200 text-xs line-clamp-3">
                {services.services.description}
              </p>
            </div>
            <div class="flex items-center justify-between p-8">
              <div>
                <p class="text-sm text-gray-500">Service Rate</p>
                <p class="text-xl font-bold text-[#121e30] leading-none">
                  Nu. {services.custom_price}
                  <span class="text-sm text-gray-500 font-normal">/-</span>
                </p>
              </div>
              <a
                href={~p"/bookings/#{services.id}/form"}
                class="bg-[#121e30] hover:bg-[#1a2f4a] text-white font-medium text-sm
                px-4 py-2 rounded-lg transition-colors duration-150 inline-flex items-center gap-1"
              >
                Book
                <.icon name="hero-arrow-right" class="size-4"/>
              </a>
            </div>
          </div>
        </div>
      <% end %>
    </div>
   <div class="w-fit mx-auto">
    <a
    href={~p"/services"}
    class="bg-[#121e30] hover:bg-[#1a2f4a] text-white font-medium text-md
      px-4 py-4 rounded-lg transition-colors duration-150 inline-flex items-center gap-1"
    >
      See More
      <.icon name="hero-chevron-double-right" class="size-5"/>
    </a>
   </div>
 </section>
<!-- ----------Services Section End---------- -->

<!-- ----------Review section starts---------- -->
<section class="px-[10%] space-y-10 py-20">
  <div class="border-b border-gray-500 pb-1">
    <h2 class="w-fit text-2xl font-bold space-y-20 relative after:absolute after:left-0 after:right-0 after:-bottom-1 after:h-1 after:w-full after:bg-gray-500">Loved by users like you</h2>
   </div>

  <div class="carousel carousel-center max-w-full p-4 space-x-4 rounded-box snap-x snap-mandatory ">
    <%= for rating <- @ratings do %>
      <div class="carousel-item snap-center w-[25vw]">
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-lg 
             transition-all duration-200 overflow-hidden w-full h-[15vw]">
          <div class="bg-gradient-to-r from-[#121e30] to-[#1a2f4a] p-8 text-white h-full">
            <span class="inline-block px-2 py-0.5 bg-white/20 rounded-full text-[10px] font-medium mb-2">
              <span class="text-xl mr-2"> <%= rating.rating %></span>
              <%= for _ <- 1..rating.rating do %>
                <span class="text-yellow-400 text-xl">★</span>
              <% end %>
            </span>
            <p class="mt-2 text-sm"><%= rating.comment %></p>
            <p class="mt-3 text-gray-200 text-xs">– <%= rating.users.username %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

 <div class="text-center">
  <.link
    navigate={~p"/ratings/new"}
    class="px-6 py-3 font-semibold rounded-xl inline-block
           transition-all duration-300 hover:scale-105
           bg-blue-600/10 text-black-500 border border-blue-600/30 
           hover:bg-blue-600/20
           dark:bg-white/10 dark:text-white dark:border-white/20
           dark:hover:bg-white/20">
    Add your Review here
  </.link>
</div>

</section>

