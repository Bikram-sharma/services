<!-- ----------Custom JS---------- -->
<script>
  const boxes = document.querySelectorAll('.box');
  let index = 0;

  function cycle() {
      boxes.forEach( b => b.classList.remove('scale-105'));

      boxes[index].classList.add('scale-105');

      index = (index + 1) % boxes.length;

      setTimeout(cycle, 4000);
  }

  cycle();
</script>
