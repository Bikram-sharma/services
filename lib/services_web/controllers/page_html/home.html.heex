<Layouts.flash_group flash={@flash} />
<!-- ----------Hero Section Start---------- -->
<section class="relative bg-gradient-to-br from-indigo-800  via-black to-indigo-800 text-white overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div
      class="absolute inset-0"
      style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
    >
    </div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 lg:py-32">
    <div class="text-center max-w-4xl mx-auto place-items-center">
      <div class="w-[20%] h-5 absolute right-[40%] top-[12%]  border-b-4 align-center rounded mb-4 shadow-[0_35px_35px_rgba(255,255,255,1)]">
      </div>
      <div
        class="inline-flex items-center bg-white/20 rounded-full px-4 py-2 mb-8 border"
        style="backdrop-filter: blur(8px);"
      >
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span class="text-sm font-medium">Trusted by 10,000+ users</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
        Connect with trusted service providers in your neighborhood
      </h1>

      <p class="text-lg sm:text-xl lg:text-2xl text-blue-100 mb-10 max-w-3xl mx-auto leading-relaxed">
        Whether you need a service or offer one, we make it simple. Book local professionals instantly or grow your business by joining our community of service providers.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-12">
        <button class="w-full sm:w-auto bg-white hover:text-white hover:border text-black px-4 py-2 rounded-full font-semibold text-lg transition-all duration-200 shadow-xl hover:shadow-2xl transform hover:-translate-y-0.5 hover:bg-gradient-to-br from-indigo-800  via-black to-indigo-800  hover:cursor-pointer">
          <a href="/dash">Find a Service</a>
        </button>
        <button class="w-full sm:w-auto bg-transparent border border-white text-white px-4 py-2 rounded-full font-semibold text-lg transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 hover:bg-gradient-to-br from-indigo-800  via-black to-indigo-800 hover:cursor-pointer">
          <a href="/service_providers/new"> Become a Provider</a>
        </button>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm sm:text-base max-w-3xl mx-auto">
        <div class="flex items-center justify-center space-x-2">
          <svg class="w-5 h-5 text-green-300" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-blue-100">Transparent Pricing</span>
        </div>
        <div class="flex items-center justify-center space-x-2">
          <svg class="w-5 h-5 text-green-300" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-blue-100">Verified Providers</span>
        </div>
        <div class="flex items-center justify-center space-x-2">
          <svg class="w-5 h-5 text-green-300" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-blue-100">Instant Booking</span>
        </div>
        <div class="flex items-center justify-center space-x-2">
          <svg class="w-5 h-5 text-green-300" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-blue-100">Flexible Scheduling</span>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M0 120L60 105C120 90 240 60 360 45C480 30 600 30 720 37.5C840 45 960 60 1080 67.5C1200 75 1320 75 1380 75L1440 75V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z"
        class="fill-[var(--color-base-100)] dark:fill-[var(--color-base-100)]"
      />
    </svg>
  </div>
</section>
<!-- ----------Hero Section End---------- -->

<!-- ----------About Us Section Start---------- -->
<section id="about" class="mx-auto py-12">
  <div class="md:w-[60%] text-center mx-auto pt-5 py-20">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
      Connecting People with the Right Services
    </h2>

    <p class="text-lg text-gray-700 dark:text-gray-300 mb-2">
      Welcome to ServiceHub, the all-in-one digital platform where people can discover, compare, and book services with trusted providers — all in just a few clicks. We bring together skilled service providers and clients who need reliable help, creating a simple and efficient way for both to connect and grow. Whether you need home repair, cleaning, beauty care, or tech support — we make finding and booking the right service fast and easy.
    </p>
  </div>

  <div class="fill-[var(--color-base-200)] dark:fill-[var(--color-base-200)]">
    <div class="max-w-[80%] mx-auto grid sm:grid-cols-1 md:grid-cols-2 gap-10 py-20">
      <div class="box border border-gray-300 dark:border-gray-700 shadow rounded-md p-5 scale-105 duration-900 bg-[#f8f8f8] dark:bg-gray-800">
        <div class="flex items-center space-x-2 pb-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            height="50px"
            viewBox="0 -960 960 960"
            width="50px"
            fill="#999999"
            class="dark:fill-gray-400"
          >
            <path d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-80q-100 0-170-70t-70-170q0-100 70-170t170-70q100 0 170 70t70 170q0 100-70 170t-170 70Zm0-80q66 0 113-47t47-113q0-66-47-113t-113-47q-66 0-113 47t-47 113q0 66 47 113t113 47Zm0-80q-33 0-56.5-23.5T400-480q0-33 23.5-56.5T480-560q33 0 56.5 23.5T560-480q0 33-23.5 56.5T480-400Z"/>
          </svg>
          <h2 class="text-xl font-bold text-gray-900 dark:text-white">Our Mission</h2>
        </div>

        <p class="text-md text-gray-700 dark:text-gray-300">
          To make everyday life easier by offering a smart, secure, and transparent platform that connects customers with quality service providers in their area.
        </p>

        <p class="text-md text-gray-700 dark:text-gray-300 mb-2 fill-[var(--color-base-300)] dark:fill-[var(--color-base-300)]">
          We aim to empower service providers to showcase their skills, grow their income, and build lasting client relationships — while helping customers save time and enjoy top-notch service experiences.
        </p>
      </div>

      <div class="box border border-gray-300 dark:border-gray-700 shadow rounded-md p-5 scale-105 duration-900 bg-[#f8f8f8] dark:bg-gray-800">
        <div class="flex items-center space-x-2 pb-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            height="50px"
            viewBox="0 -960 960 960"
            width="50px"
            fill="#999999"
            class="dark:fill-gray-400"
          >
            <path d="M480-320q75 0 127.5-52.5T660-500q0-75-52.5-127.5T480-680q-75 0-127.5 52.5T300-500q0 75 52.5 127.5T480-320Zm0-72q-45 0-76.5-31.5T372-500q0-45 31.5-76.5T480-608q45 0 76.5 31.5T588-500q0 45-31.5 76.5T480-392Zm0 192q-146 0-266-81.5T40-500q54-137 174-218.5T480-800q146 0 266 81.5T920-500q-54 137-174 218.5T480-200Zm0-300Zm0 220q113 0 207.5-59.5T832-500q-50-101-144.5-160.5T480-720q-113 0-207.5 59.5T128-500q50 101 144.5 160.5T480-280Z" />
